{
  "info": {
    "name": "TaskBoard — TB-3",
    "description": "Rejestracja, logowanie, tablice, zadania i filtry. Postman przechowuje ciasteczko sesji pomiędzy żądaniami.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000"
    },
    {
      "key": "boardId",
      "value": "1"
    },
    {
      "key": "taskId",
      "value": "1"
    },
    {
      "key": "login",
      "value": "nowy.uzytkownik"
    },
    {
      "key": "password",
      "value": "zmien-to-haslo"
    }
  ],
  "item": [
    {
      "name": "Health",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/health"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP status is 200\", function () { pm.response.to.have.status(200); });"
            ]
          }
        }
      ]
    },
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"login\": \"{{login}}\",\n  \"password\": \"{{password}}\",\n  \"firstName\": \"Nowy\",\n  \"lastName\": \"Użytkownik\"\n}"
            },
            "url": "{{baseUrl}}/api/auth/register"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP status is 201\", function () { pm.response.to.have.status(201); });",
                  "pm.test(\"Response does not expose passwordHash\", function () { if (pm.response.code >= 200 && pm.response.code < 300 && pm.response.code !== 204) pm.expect(pm.response.text()).not.to.include(\"passwordHash\"); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"login\": \"{{login}}\",\n  \"password\": \"{{password}}\"\n}"
            },
            "url": "{{baseUrl}}/api/auth/login"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP status is 200\", function () { pm.response.to.have.status(200); });",
                  "pm.test(\"Response does not expose passwordHash\", function () { if (pm.response.code >= 200 && pm.response.code < 300 && pm.response.code !== 204) pm.expect(pm.response.text()).not.to.include(\"passwordHash\"); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Login with invalid credentials — expect 401",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"login\": \"invalid.user.404\",\n  \"password\": \"incorrect-password\"\n}"
            },
            "url": "{{baseUrl}}/api/auth/login"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP status is 401\", function () { pm.response.to.have.status(401); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Me",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/auth/me"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP status is 200\", function () { pm.response.to.have.status(200); });",
                  "pm.test(\"Response does not expose passwordHash\", function () { if (pm.response.code >= 200 && pm.response.code < 300 && pm.response.code !== 204) pm.expect(pm.response.text()).not.to.include(\"passwordHash\"); });"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Boards",
      "item": [
        {
          "name": "List boards",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/boards"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP status is 200\", function () { pm.response.to.have.status(200); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Create board",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Tablica testowa\",\n  \"description\": \"Utworzona z Postmana\"\n}"
            },
            "url": "{{baseUrl}}/api/boards"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP status is 201\", function () { pm.response.to.have.status(201); });",
                  "if (pm.response.code === 201) { pm.collectionVariables.set(\"boardId\", pm.response.json().id); }"
                ]
              }
            }
          ]
        },
        {
          "name": "Update board",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Zmieniona tablica\",\n  \"description\": \"Opis po zmianie\"\n}"
            },
            "url": "{{baseUrl}}/api/boards/{{boardId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP status is 200\", function () { pm.response.to.have.status(200); });"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Tasks and filters",
      "item": [
        {
          "name": "Missing task — expect 404",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/tasks/999999"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP status is 404\", function () { pm.response.to.have.status(404); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Malformed JSON — expect 400",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"title\":"
            },
            "url": "{{baseUrl}}/api/tasks"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP status is 400\", function () { pm.response.to.have.status(400); });",
                  "pm.test(\"Error response explains invalid JSON\", function () { pm.expect(pm.response.json().error).to.include(\"JSON\"); });"
                ]
              }
            }
          ]
        },
        {
          "name": "List tasks",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/boards/{{boardId}}/tasks"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP status is 200\", function () { pm.response.to.have.status(200); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Combined filters",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/boards/{{boardId}}/tasks?priority=high&assigneeId=1&q=API"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP status is 200\", function () { pm.response.to.have.status(200); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Invalid assigneeId — expect 400",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/boards/{{boardId}}/tasks?assigneeId=abc"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP status is 400\", function () { pm.response.to.have.status(400); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Task details",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/tasks/{{taskId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP status is 200\", function () { pm.response.to.have.status(200); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Create task",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Nowe zadanie z Postmana\",\n  \"description\": \"Opis testowy\",\n  \"status\": \"todo\",\n  \"priority\": \"medium\",\n  \"deadline\": null,\n  \"boardId\": {{boardId}},\n  \"assigneeId\": null\n}"
            },
            "url": "{{baseUrl}}/api/tasks"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP status is 201\", function () { pm.response.to.have.status(201); });",
                  "if (pm.response.code === 201) { pm.collectionVariables.set(\"taskId\", pm.response.json().id); }"
                ]
              }
            }
          ]
        },
        {
          "name": "Invalid task title — expect 400",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"x\",\n  \"boardId\": 1\n}"
            },
            "url": "{{baseUrl}}/api/tasks"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP status is 400\", function () { pm.response.to.have.status(400); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Update task",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Zmienione zadanie\",\n  \"description\": \"Opis po zmianie\",\n  \"status\": \"in_progress\",\n  \"priority\": \"high\",\n  \"deadline\": null,\n  \"boardId\": 1,\n  \"assigneeId\": 1\n}"
            },
            "url": "{{baseUrl}}/api/tasks/{{taskId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP status is 200\", function () { pm.response.to.have.status(200); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Delete task",
          "request": {
            "method": "DELETE",
            "url": "{{baseUrl}}/api/tasks/{{taskId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP status is 204\", function () { pm.response.to.have.status(204); });"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Users",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/users"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP status is 200\", function () { pm.response.to.have.status(200); });",
              "pm.test(\"Response does not expose passwordHash\", function () { if (pm.response.code >= 200 && pm.response.code < 300 && pm.response.code !== 204) pm.expect(pm.response.text()).not.to.include(\"passwordHash\"); });"
            ]
          }
        }
      ]
    },
    {
      "name": "Delete board",
      "request": {
        "method": "DELETE",
        "url": "{{baseUrl}}/api/boards/{{boardId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP status is 204\", function () { pm.response.to.have.status(204); });"
            ]
          }
        }
      ]
    },
    {
      "name": "Logout",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/api/auth/logout"
      }
    }
  ]
}
