# Local XAMPP configuration. Copy/create this as .env in the project root.
# This local development database account is intentionally fixed for the class project.
DB_HOST=localhost
DB_PORT=3306
DB_USER=taskboard_app
DB_PASSWORD=TBpassword123
DB_NAME=taskboard

# Run: node backend/create-env.js
# The setup script replaces this marker with a fresh cryptographically random secret.
SESSION_SECRET=GENERATE_ON_SETUP
